extends Node
## Global gameplay signals. Holds no state. Systems emit here; HUD, audio, VFX, progression and analytics listen.
## The list matches ARCHITECTURE.md section 2. Add a signal there first.

@warning_ignore("unused_signal")
signal champion_spawned(champion: Node, peer_id: int, team: int)
@warning_ignore("unused_signal")
signal champion_damaged(target: Node, source: Node, amount: float, ability_id: StringName)
@warning_ignore("unused_signal")
signal champion_healed(target: Node, source: Node, amount: float)
@warning_ignore("unused_signal")
signal champion_shielded(target: Node, amount: float, duration: float)
@warning_ignore("unused_signal")
signal champion_died(victim: Node, killer: Node, ability_id: StringName)
@warning_ignore("unused_signal")
signal champion_respawned(champion: Node)
@warning_ignore("unused_signal")
signal ability_cast(caster: Node, ability_id: StringName, slot: int)
@warning_ignore("unused_signal")
signal ability_ready(caster: Node, slot: int)
@warning_ignore("unused_signal")
signal ultimate_charge_changed(caster: Node, value: float)
@warning_ignore("unused_signal")
signal status_applied(target: Node, status_id: StringName, duration: float)
@warning_ignore("unused_signal")
signal status_removed(target: Node, status_id: StringName)
@warning_ignore("unused_signal")
signal objective_state_changed(owner_team: int, progress: float, contested: bool)
@warning_ignore("unused_signal")
signal score_changed(team: int, score: int)
@warning_ignore("unused_signal")
signal match_phase_changed(phase: StringName)
