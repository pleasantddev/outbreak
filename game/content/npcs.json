  {
   "id": "bs.turn.2",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} lost a brother to a police bullet at a checkpoint and does not talk about it.",
   "minAge": 20
  },
  {
   "id": "bs.turn.3",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} was scammed out of the school fees savings by a man who called himself a pastor."
  },
  {
   "id": "bs.turn.4",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} once went to jail for a weekend over a misunderstanding with an officer and has remembered every face since.",
   "minAge": 20
  },
  {
   "id": "bs.turn.5",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} got into a fight at fifteen that left {him} with a scar and a reputation.",
   "maxAge": 45
  },
  {
   "id": "bs.turn.6",
   "kind": "backstory",
   "slot": "turn",
   "text": "A flood took the room and everything in it, and {he} has kept receipts for everything since."
  },
  {
   "id": "bs.turn.7",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} was robbed at gunpoint on the way home and moved house within the month.",
   "minAge": 18
  },
  {
   "id": "bs.turn.8",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} lost a business partner who vanished with the money and the van.",
   "minAge": 25
  },
  {
   "id": "bs.turn.9",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} was beaten by a mob once for something {he} did not do, and has been wary of crowds since."
  },
  {
   "id": "bs.turn.10",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} won a small contract once, and the memory of what it paid keeps {him} chasing the next one.",
   "minAge": 24
  },
  {
   "id": "bs.turn.11",
   "kind": "backstory",
   "slot": "turn",
   "text": "{He} buried a parent last year and is still paying for the funeral.",
   "minAge": 22
  },
  {
   "id": "bs.ambition.1",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} wants to open a bigger place before the next Christmas."
  },
  {
   "id": "bs.ambition.2",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} is saving to leave Lagos and start again somewhere quiet.",
   "minAge": 25
  },
  {
   "id": "bs.ambition.3",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} wants to be respected on this street and has a plan for how.",
   "occ": [
    "occ.area_boy",
    "occ.hustler",
    "occ.unemployed",
    "occ.okada",
    "occ.conductor"
   ]
  },
  {
   "id": "bs.ambition.4",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} wants {his} children to never do this kind of work.",
   "minAge": 28
  },
  {
   "id": "bs.ambition.5",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} is waiting for one good contract to change everything."
  },
  {
   "id": "bs.ambition.6",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} dreams of a visa and a flight, in that order.",
   "maxAge": 38
  },
  {
   "id": "bs.ambition.7",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} wants to own the land under {his} feet and trusts nobody with the papers.",
   "minAge": 30
  },
  {
   "id": "bs.ambition.8",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} is climbing and does not mind who is standing on the step above.",
   "occ": [
    "occ.police",
    "occ.civil_servant",
    "occ.bank_staff",
    "occ.area_boy",
    "occ.conductor"
   ]
  },
  {
   "id": "bs.ambition.9",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} prays for peace and keeps a cutlass under the bed anyway.",
   "minAge": 30
  },
  {
   "id": "bs.ambition.10",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} wants to finish school, whatever it takes.",
   "occ": [
    "occ.student",
    "occ.hustler",
    "occ.unemployed"
   ]
  },
  {
   "id": "bs.ambition.11",
   "kind": "backstory",
   "slot": "ambition",
   "text": "{He} is tired and just wants the month to end with a little left over.",
   "minAge": 30
  },
  {
   "id": "taunt.hurt.1",
   "kind": "taunt",
   "when": "hurt",
   "lines": [
    "You remember me? {place}. You touched me there and thought it was finished.",
    "Ah ah! Na you. {place}, you carry hand for me. I no forget.",
    "I dey wait for you since {place}. Today na today."
   ]
  },
  {
   "id": "taunt.hurt.areaboys.1",
   "kind": "taunt",
   "when": "hurt",
   "lines": [
    "{Name} still dey here. You thought I go forget {place}?",
    "You wan run again? Like {place}?"
   ],
   "faction": "areaboys"
  },
  {
   "id": "taunt.robbed.1",
   "kind": "taunt",
   "when": "robbed",
   "lines": [
    "You collect my money for {place}. Bring am back, or bring your head.",
    "Na you rob me! {place}! I get your face for my mind.",
    "My money wey you take for {place}? I never finish counting am."
   ]
  },
  {
   "id": "taunt.carjacked.1",
   "kind": "taunt",
   "when": "carjacked",
   "lines": [
    "You carry my {item} for {place}! Where e dey?",
    "Oga, my {item}. {place}. You think say Lagos wide pass my memory?",
    "Na you steal my {item}! I never recover from that wahala."
   ]
  },
  {
   "id": "taunt.carjacked.okada.1",
   "kind": "taunt",
   "when": "carjacked",
   "lines": [
    "Thief! Thief! Na my {item} you take for {place}!",
    "Hold am! This one carry my {item} for {place}!"
   ],
   "faction": "okada"
  },
  {
   "id": "taunt.beat_you.1",
   "kind": "taunt",
   "when": "beat_you",
   "lines": [
    "I put you down for {place} and now you dey walk for my street?",
    "Remember {place}? You were on the ground and I was standing. Make you no forget.",
    "They call me {rank} now. Na you help me reach there, after {place}."
   ]
  },
  {
   "id": "taunt.survived.1",
   "kind": "taunt",
   "when": "survived",
   "lines": [
    "You thought you finish me for {place}. I still dey stand.",
    "I survive {place}. Look my face. Look am well.",
    "Na God save me for {place}. Now na your turn."
   ]
  },
  {
   "id": "taunt.killed_kin.1",
   "kind": "taunt",
   "when": "killed_kin",
   "lines": [
    "You kill my {rel} for {place}. I swear, one of us no go leave here.",
    "My {rel} dey for ground because of you, {place}. This one na family matter."
   ]
  },
  {
   "id": "taunt.returned.1",
   "kind": "taunt",
   "when": "returned",
   "lines": [
    "You thought I die? {place} no fit finish me. I come back stronger.",
    "Dead man dey talk to you. {place}. Say your prayer.",
    "Look at me. You do this, {place}. I come back with friends."
   ]
  },
  {
   "id": "taunt.betrayed.1",
   "kind": "taunt",
   "when": "betrayed",
   "lines": [
    "I trusted you and you sold me for small money. Never again.",
    "Na you spoil my name. I go spoil yours."
   ]
  },
  {
   "id": "taunt.witnessed.1",
   "kind": "taunt",
   "when": "witnessed",
   "lines": [
    "I see wetin you do for {place}. I no go talk, but I no go forget.",
    "Please, abeg, no do me anything. I no tell anybody about {place}."
   ]
  },
  {
   "id": "taunt.helped.1",
   "kind": "taunt",
   "when": "helped",
   "lines": [
    "Ah, my person! You remember me? {place}. I never forget your help.",
    "Na you help me for {place}. Anything you need, just call me.",
    "God go bless you for {place}. You get one person for this street."
   ]
  },
  {
   "id": "taunt.tipped.1",
   "kind": "taunt",
   "when": "tipped",
   "lines": [
    "Oga, the small money wey you drop for me for {place}, e save my week. Thank you.",
    "You be good person. I go carry your name for prayers."
   ]
  },
  {
   "id": "taunt.met.1",
   "kind": "taunt",
   "when": "met",
   "lines": [
    "Oga, I know you. Everybody for {area} don hear.",
    "You be the one from {place}? Na you.",
    "Hmm. See who come {area} today."
   ]
  },
  {
   "id": "taunt.promoted.1",
   "kind": "taunt",
   "when": "promoted",
   "lines": [
    "Na you make me {rank}. Remember dat.",
    "E no be small thing. {rank} {Name}, that is me now."
   ]
  },
  {
   "id": "taunt.ambush.1",
   "kind": "taunt",
   "when": "ambush",
   "lines": [
    "Una hold am! Na this one!",
    "We don find you. {place} no go save you.",
    "Today you go pay for {place}."
   ]
  },
  {
   "id": "taunt.fear.1",
   "kind": "taunt",
   "when": "fear",
   "lines": [
    "Abeg, abeg, I no get anything.",
    "Oga please, I no do anything.",
    "Ah! Na you again! Please, I get family!"
   ]
  },
  {
   "id": "taunt.ally_join.1",
   "kind": "taunt",
   "when": "ally_join",
   "lines": [
    "Oga, I dey with you! Make we handle these guys!",
    "Na my person dey inside wahala. Move!",
    "You no go fight alone! I reach!"
   ]
  },
  {
   "id": "taunt.ally_greet.1",
   "kind": "taunt",
   "when": "ally_greet",
   "lines": [
    "My guy! You dey alright?",
    "Na you be dat! Lagos small o.",
    "Oga, anything you need, I dey around."
   ]
  },
  {
   "id": "taunt.ally_betray.1",
   "kind": "taunt",
   "when": "ally_betray",
   "lines": [
    "I no wan do this, but I get my own matter. Sorry, my guy."
   ]
  },
