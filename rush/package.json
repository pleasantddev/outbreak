{
  "name": "lagos-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lagos Rush: a room-based arcade racer on a map of Oshodi built from OpenStreetMap data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gis:fetch": "node tools/gis/fetch-osm.mjs",
    "gis:build": "tsx tools/gis/build-world.ts",
    "gis": "npm run gis:fetch && npm run gis:build"
  },
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  }
}
