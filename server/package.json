{
  "name": "hustlelife-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server/src/main.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "loadtest": "tsx tools/loadtest.ts",
    "build-plots": "tsx tools/build-plots.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
