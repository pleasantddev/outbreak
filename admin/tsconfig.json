{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "types": ["node", "vite/client"],
    "baseUrl": ".", "paths": { "@world/*": ["../v2/src/world/*"], "@srv/*": ["../server/admin/*"], "react": ["./node_modules/preact/compat"], "react-dom": ["./node_modules/preact/compat"] }
  },
  "include": ["src", "dev-server.ts", "tools", "../server", "../v2/src/world/region.ts", "../v2/src/world/plots.ts", "../v2/src/world/geo.ts"]
}
